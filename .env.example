# Skopiuj do .env i uzupełnij. .env NIGDY nie trafia do repozytorium.

# --- baza ---
# PostgreSQL w Neonie. Połączenie przez pulę dla tras, bezpośrednie dla migracji.
# `DATABASE_URL` jest JEDYNĄ odpowiedzią na pytanie „którą bazę otwieramy"
# (`magazyn.adres_bazy`). Wartości domyślnej nie ma świadomie: adres zgadnięty
# prowadziłby do serwera, którego nikt nie wskazał.
DATABASE_URL=postgresql://uzytkownik:haslo@host.neon.tech/doradca?sslmode=require
# Połączenie Z POMINIĘCIEM PULI — tędy idzie migracja schematu, bo pula nie
# utrzymuje sesji między poleceniami, a migracja jest jedną sesją od początku
# do końca. Neon nazywa ten adres `DATABASE_URL_UNPOOLED`; przy bazie lokalnej
# zmiennej można nie ustawiać — wtedy migracja idzie tym samym adresem.
DATABASE_URL_BEZPOSREDNI=postgresql://uzytkownik:haslo@host.neon.tech/doradca?sslmode=require

# --- baza TESTOWA ---
# OSOBNA zmienna, nie `DATABASE_URL`. Suita zakłada i kasuje przestrzenie nazw,
# więc puszczona na bazie roboczej kasowałaby dane. Bez tej zmiennej suita
# ODMAWIA startu — celowo nie pomija testów: przebieg kończący się kodem 0
# z „N skipped" wygląda jak sukces i nim nie jest.
DATABASE_URL_TESTY=postgresql://postgres:haslo@localhost:5434/doradca_test

# --- model językowy ---
# Bramka AI Vercela. Doradca formułuje zdania; kwoty liczy silnik.
AI_GATEWAY_API_KEY=
MODEL_DORADCY=anthropic/claude-sonnet-5

# --- baza wiedzy o stawkach ---
# Publiczne, wyłącznie do odczytu, nie dostają żadnych danych użytkownika.
ELI_API=https://api.sejm.gov.pl/eli
GUS_BDL_API=https://bdl.stat.gov.pl/api/v1
